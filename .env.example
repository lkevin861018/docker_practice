# PowerShell: Copy-Item .env.example .env  (only for a NEW installation)
# Upgrading an existing project: keep your current .env and APPEND the three PGADMIN_* values.
POSTGRES_DB=labdb
POSTGRES_USER=labuser
POSTGRES_PASSWORD=REPLACE_ME_WITH_LONG_RANDOM_PASSWORD
WEB_PORT=8080

# Login credentials for pgAdmin web UI (different from PostgreSQL credentials).
PGADMIN_DEFAULT_EMAIL=admin@example.com
PGADMIN_DEFAULT_PASSWORD=REPLACE_ME_WITH_A_DIFFERENT_LONG_PASSWORD
PGADMIN_PORT=5050

# v3 roles: add these four values to an EXISTING .env; keep original DB credentials.
APP_DB_USER=flask_app
APP_DB_PASSWORD=REPLACE_ME_WITH_APP_ONLY_LONG_PASSWORD
REPORT_DB_USER=report_reader
REPORT_DB_PASSWORD=REPLACE_ME_WITH_DIFFERENT_READONLY_PASSWORD

# v4: append these to your EXISTING .env. Use new passwords.
METRICS_DB_USER=metrics_reader
METRICS_DB_PASSWORD=REPLACE_ME_WITH_METRICS_ONLY_LONG_PASSWORD
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=REPLACE_ME_WITH_GRAFANA_ONLY_LONG_PASSWORD
GRAFANA_PORT=3000
PROMETHEUS_PORT=9090

# v5 alert notifications (localhost only by default; no email credentials necessary)
ALERTMANAGER_PORT=9093
MAILPIT_UI_PORT=8025
